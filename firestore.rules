rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    // الأدمن = (إيميل مؤكَّد من القائمة دي) أو (وثيقة باسم الـ uid في collection اسمها admins).
    // email_verified مهم: من غيره حد يقدر يسجل بإيميل الأدمن كـ email/password من غير ما يثبت إنه بتاعه.
    // لو بتدخل بإيميل/باسورد وإيميلك مش مؤكد: ادخل بجوجل، أو أضف وثيقة في admins/{uid} من الـ Console.
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email_verified == true
          && request.auth.token.email in ['alikimo1942@gmail.com'])
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // الطالب حضر الفعالية فعلاً (الأدمن سجّل حضوره): شرط التقييم وأسئلة القاعة
    function didAttend(actId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/activities/$(actId)/registrations/$(request.auth.uid))
        && get(/databases/$(database)/documents/activities/$(actId)/registrations/$(request.auth.uid)).data.get('attended', false) == true;
    }
    function okStar(d, k) {
      return !(k in d) || (d[k] is int && d[k] >= 1 && d[k] <= 5);
    }

    // قايمة الأدمنز: الشخص يقدر يقرا وثيقته هو بس (عشان الواجهة تعرف)، والكتابة من الـ Console بس.
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // بيانات كل طالب
    match /students/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());

      allow create: if isSignedIn() && request.auth.uid == uid
        // حقول معروفة بس: يمنع الطالب يكتب autoPoints أو hideFromRanking أو أي حقل إداري وقت التسجيل
        && request.resource.data.keys().hasOnly(['name','studentId','level','points','events','workshops',
                                                  'competitions','campaigns','activeLevel','email','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.get('studentId', '') is string && request.resource.data.get('studentId', '').size() <= 30
        && request.resource.data.get('level', '') is string && request.resource.data.get('level', '').size() <= 40
        && request.resource.data.get('points', 0) == 0
        && request.resource.data.get('events', 0) == 0
        && request.resource.data.get('workshops', 0) == 0
        && request.resource.data.get('competitions', 0) == 0
        && request.resource.data.get('campaigns', 0) == 0;

      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'level', 'bio', 'photoURL'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.level is string
          && request.resource.data.level.size() <= 40
          && request.resource.data.get('bio', '') is string
          && request.resource.data.get('bio', '').size() <= 140
          && request.resource.data.get('photoURL', '') is string
          && (request.resource.data.get('photoURL', '') == ''
              || request.resource.data.get('photoURL', '').matches('https://res\\.cloudinary\\.com/dju33knsd/.*')))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['events'])
          && request.resource.data.events == resource.data.get('events', 0) + 1)
      ));

      allow delete: if isAdmin();
    }

    // الفعاليات والمؤتمرات والأنشطة
    match /activities/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn() && (
        // "مهتم": الطالب يضيف نفسه بس
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['interestedUids'])
          && request.resource.data.get('interestedUids', []).hasAll(resource.data.get('interestedUids', []))
          && request.resource.data.get('interestedUids', []).size() == resource.data.get('interestedUids', []).size() + 1
          && request.auth.uid in request.resource.data.interestedUids)
        ||
        // تسجيل حضور: عدّاد +1 مع إنشاء وثيقة التسجيل، وبحد أقصى السعة
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
          && request.resource.data.registeredCount == resource.data.get('registeredCount', 0) + 1
          && request.resource.data.registeredCount <= resource.data.get('capacity', 1000000)
          && resource.data.get('registrationClosed', false) == false
          && !exists(/databases/$(database)/documents/activities/$(id)/registrations/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/activities/$(id)/registrations/$(request.auth.uid)))
        ||
        // إلغاء التسجيل: عدّاد -1 مع حذف وثيقة التسجيل
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
          && request.resource.data.registeredCount == resource.data.get('registeredCount', 0) - 1
          && request.resource.data.registeredCount >= 0
          && exists(/databases/$(database)/documents/activities/$(id)/registrations/$(request.auth.uid))
          && !existsAfter(/databases/$(database)/documents/activities/$(id)/registrations/$(request.auth.uid)))
      ));

      match /registrations/{uid} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
        // التسجيل بيتعمل بالحقول دي بس، و attended لازم false — الحضور بيسجّله الأدمن (QR أو يدوي) مش الطالب
        allow create: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['uid','name','studentId','level','createdAt','attended'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.attended == false
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.get('studentId', '') is string && request.resource.data.get('studentId', '').size() <= 30
          && request.resource.data.get('level', '') is string && request.resource.data.get('level', '').size() <= 40
          && getAfter(/databases/$(database)/documents/activities/$(id)).data.get('registeredCount', 0)
             == get(/databases/$(database)/documents/activities/$(id)).data.get('registeredCount', 0) + 1;
        allow update: if isAdmin();
        // الطالب يلغي تسجيله قبل الحضور بس (بعد الحضور السجل ثابت)
        allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid
          && resource.data.get('attended', false) == false
          && getAfter(/databases/$(database)/documents/activities/$(id)).data.get('registeredCount', 0)
             == get(/databases/$(database)/documents/activities/$(id)).data.get('registeredCount', 0) - 1);
      }

      // تقييم الفعالية: وثيقة واحدة لكل طالب حضر، والأدمن يقرأ الكل
      match /feedback/{uid} {
        allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
        allow create, update: if isSignedIn() && request.auth.uid == uid && didAttend(id)
          && request.resource.data.keys().hasOnly(['uid','name','overall','content','organization','speaker','comment','updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.overall is int && request.resource.data.overall >= 1 && request.resource.data.overall <= 5
          && okStar(request.resource.data, 'content') && okStar(request.resource.data, 'organization') && okStar(request.resource.data, 'speaker')
          && request.resource.data.get('comment', '') is string && request.resource.data.get('comment', '').size() <= 300
          && request.resource.data.name is string && request.resource.data.name.size() <= 60;
        allow delete: if isAdmin();
      }

      // أسئلة القاعة: الحاضرين بس يسألوا، وأي حاضر يرفع سؤال (مرة واحدة)، والأدمن يجاوب/يحذف
      match /questions/{qid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && didAttend(id)
          && request.resource.data.keys().hasOnly(['uid','name','text','createdAt','upUids','answered'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 200
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.get('upUids', []).size() == 0
          && request.resource.data.get('answered', false) == false;
        allow update: if isAdmin() || (didAttend(id)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['upUids'])
          && request.resource.data.get('upUids', []).hasAll(resource.data.get('upUids', []))
          && request.resource.data.get('upUids', []).size() == resource.data.get('upUids', []).size() + 1
          && request.auth.uid in request.resource.data.upUids);
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // الأخبار — قراءة للكل، والطالب يقدر يعمل/يشيل لايك لنفسه بس
    match /news/{id} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeUids'])
        && (
          // إضافة إعجاب: الطالب يضيف نفسه بس
          (request.resource.data.get('likeUids', []).hasAll(resource.data.get('likeUids', []))
            && request.resource.data.get('likeUids', []).size() == resource.data.get('likeUids', []).size() + 1
            && request.auth.uid in request.resource.data.likeUids)
          ||
          // إلغاء إعجاب: الطالب يشيل نفسه بس
          (resource.data.get('likeUids', []).hasAll(request.resource.data.get('likeUids', []))
            && request.resource.data.get('likeUids', []).size() == resource.data.get('likeUids', []).size() - 1
            && !(request.auth.uid in request.resource.data.get('likeUids', [])))
        ));
    }

    // محتوى عام — يتقرا من أي حد، والتعديل للأدمن بس
    match /magazines/{id}   { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /campaigns/{id}   { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /committees/{id}  { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /leaderboard/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /members/{id}     { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /media/{id}       { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /config/{id}      { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // إعلانات الاتحاد للطلاب: القراءة للمسجّلين، والنشر والحذف للأدمن
    match /announcements/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // التصويت
    match /polls/{pollId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();

      match /votes/{uid} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == uid
          && request.resource.data.option is int
          && request.resource.data.option >= 0
          && request.resource.data.option < get(/databases/$(database)/documents/polls/$(pollId)).data.options.size()
          && (!('endsAt' in get(/databases/$(database)/documents/polls/$(pollId)).data)
              || get(/databases/$(database)/documents/polls/$(pollId)).data.endsAt > request.time);
        allow update, delete: if false;
      }
    }
  }
}
